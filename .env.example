# Supabase project (Settings > API). The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server only. Long random string (openssl rand -hex 32). Seeds item draws and pairings so clients cannot predict them.
MULTIPLAYER_SEED_SECRET=change-me

# Server only. Shared with the pg_cron sweeper job (supabase/cron.sql).
MULTIPLAYER_CRON_SECRET=change-me-too
