# --- Supabase (see docs/SUPABASE_SETUP.md) ---
# Project URL. Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Recommended (2026+): publishable key from Project Settings > API Keys (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy until end of 2026: anon JWT from the same page. Use publishable if you have both.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server only. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
# Recommended: secret key (sb_secret_...).
SUPABASE_SECRET_KEY=your-secret-key

# Legacy: service_role JWT.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional duplicate of the URL for server-only code (same value as NEXT_PUBLIC_SUPABASE_URL).
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Server only. Long random string (openssl rand -hex 32). Seeds item draws and pairings.
MULTIPLAYER_SEED_SECRET=change-me

# Server only. Shared with the Supabase Cron sweeper job (supabase/cron.sql).
MULTIPLAYER_CRON_SECRET=change-me-too
